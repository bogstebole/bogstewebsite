# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local-only dev tooling — must never reach main
/components/dev/
/vendor/*
!/vendor/inline-chat-kit.tgz

# raw source recordings — the compressed cuts that ship live in public/
/assets/assets for new hero section/*.mp4

# Claude Code's per-machine state: its worktrees and local settings.
.claude/worktrees/
.claude/settings.local.json

# Copies the filesystem makes beside a file being edited ("doc 2.tsx",
# "nav 2.ts"). 179 of them appeared at once in October; none belongs in git.
# Code and text only: an image or a video named "Step 2.png" is a real asset.
* [0-9].ts
* [0-9].tsx
* [0-9].js
* [0-9].mjs
* [0-9].css
* [0-9].md
* [0-9].json

# Local-only notes. Never pushed.
/private/

# Notes and instructions for working on the site, kept on this machine:
# the project notes, the PRD, and the agent instruction files (Next writes
# AGENTS.md itself on every `next dev`).
/memory/
/PRD.md
/AGENTS.md
/CLAUDE.md
